rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Published official PDFs (mirrored copies of source documents).
    // Public read; only Cloud Functions (Admin SDK, bypasses rules) or an
    // admin may write.
    match /documents/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else is private by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

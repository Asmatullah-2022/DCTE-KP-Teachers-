# ---------------------------------------------------------------------------
# DCTE KP Teachers — environment placeholders
# Copy this file to `.env` (Flutter app root) and fill in values.
# NEVER commit the real `.env` file. NEVER put Firebase Admin credentials,
# service-account JSON, or AI API keys into the Flutter app — they belong
# only in Cloud Functions runtime config / Secret Manager.
# ---------------------------------------------------------------------------

# Optional: override the environment name shown in Settings > About.
APP_ENV=development

# Optional: Firebase App Check debug token for local/dev builds
# (get this from the App Check debug provider console output on first run).
APP_CHECK_DEBUG_TOKEN=

# Base URLs for official sources (safe to expose in-app; used only to link
# out to the original government pages, never to scrape from the client).
DCTE_BASE_URL=https://dcte.kpese.gov.pk/
KPESE_BASE_URL=https://kpese.gov.pk/
KPESE_NOTIFICATIONS_URL=https://kpese.gov.pk/category/notifications/
DCTE_SEMESTER_NOTIFICATION_PDF=https://dcte.kpese.gov.pk/wp-content/uploads/Revised-Notification-Semester-wise-Course-Grade-I-VIII-final-draft.pdf

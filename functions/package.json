{
  "name": "dcte-kp-teachers-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions (2nd gen) backend for DCTE KP Teachers: scheduled official-source monitoring, document pipeline, admin API, and assistant callable.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "node-fetch": "^2.7.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@types/node-fetch": "^2.6.11",
    "@types/pdf-parse": "^1.1.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
